# Mentions légales (obligatoires pour une compilation de production : CHECK_LEGAL=1).
# Nom ou pseudonyme de l'éditeur ; l'adresse postale est facultative pour un
# éditeur non professionnel dont l'identité est détenue par l'hébergeur.
PUBLISHER_NAME=
PUBLISHER_ADDRESS=
CONTACT_EMAIL=
# Raison sociale et adresse de l'hébergeur, ex. « Vercel Inc., États-Unis (vercel.com) ».
HOSTING_PROVIDER=

# Dossier de la base PGlite (par défaut : data/db).
CATALOGUE_DB=
